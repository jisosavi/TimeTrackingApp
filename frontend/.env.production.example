# Copy this file to .env.production and fill in your Railway URL before building.
# The URL should NOT have a trailing slash.
VITE_API_BASE=https://your-app.up.railway.app

# Sub-path where the Vue app is served. Must start and end with a slash.
# Examples: /test/TimeTrackingAppVue/   or just  /  for the domain root.
VITE_APP_BASE=/test/TimeTrackingAppVue/
