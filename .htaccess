<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Älä muuta staattisia tiedostoja
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Reitä /{slug}/admin/* → /company/{slug}/admin/index.html
  RewriteRule ^([a-z0-9-]+)/admin/?$ /company/$1/admin/index.html [L]
  
  # Reitä /{slug}/admin/{asset} → /company/{slug}/admin/{asset}
  RewriteRule ^([a-z0-9-]+)/admin/(.*)$ /company/$1/admin/$2 [L]

  # Taaksepäin yhteensopivuus vanhoille /company/{slug}/admin-poluille
  RewriteRule ^company/([a-z0-9-]+)/admin/?$ /company/$1/admin/index.html [L]
  RewriteRule ^company/([a-z0-9-]+)/admin/(.*)$ /company/$1/admin/$2 [L]
</IfModule>